{
  "name": "jamie-ui",
  "devDependencies": {
    "eslint-plugin-better-tailwindcss": "4.5.0",
    "oxfmt": "0.48.0",
    "oxlint": "1.63.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0"
  },
  "private": true,
  "scripts": {
    "dev": "bun run --filter=@jamie-ui/docs dev",
    "build": "bun run --filter=* build",
    "lint": "oxlint packages apps/docs/app apps/docs/lib",
    "lint:fix": "oxlint --fix packages apps/docs/app apps/docs/lib",
    "format": "oxfmt --write packages apps/docs/app apps/docs/lib",
    "format:check": "oxfmt --check packages apps/docs/app apps/docs/lib",
    "typecheck": "tsc --noEmit -p packages/ui/tsconfig.json && tsc --noEmit -p packages/json-render/tsconfig.json && tsc --noEmit -p apps/docs/tsconfig.json",
    "check": "bun run typecheck && oxlint packages apps/docs/app apps/docs/lib && oxfmt --check packages apps/docs/app apps/docs/lib"
  },
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "@phosphor-icons/react": "2.1.10"
  }
}
